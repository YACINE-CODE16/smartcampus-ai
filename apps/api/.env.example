# Copié en .env par `npm run setup` (avec un JWT_SECRET aléatoire).
# Toutes les valeurs ont un défaut sûr en développement.
NODE_ENV=development
PORT=3000
ADAPTERS_MODE=local
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-at-least-32-characters-long
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./storage/uploads
MAIL_OUTBOX_DIR=./storage/outbox
