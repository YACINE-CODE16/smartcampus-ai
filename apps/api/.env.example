# Copié en .env par `npm run setup`. Toutes les valeurs ont un défaut sûr en développement.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://smartcampus:smartcampus@localhost:55432/smartcampus
JWT_SECRET=change-me-at-least-32-characters-long
COOKIE_SECURE=false

# Démo : comptes seedés affichés sur la page de connexion
DEMO_MODE=true
DEMO_PASSWORD=Campus2026!

# Adapters
AUTH_PROVIDER=local
STORAGE_DRIVER=local          # local | s3
UPLOAD_DIR=./storage/uploads
# S3_BUCKET=smartcampus-photos-xxxx
AI_DRIVER=mock                # mock | bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
