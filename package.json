{
  "name": "smartcampus-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @smartcampus/api\" \"npm run dev -w @smartcampus/web\"",
    "build": "npm run build -w @smartcampus/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "db:migrate": "npm run db:migrate -w @smartcampus/api",
    "db:studio": "npm run db:studio -w @smartcampus/api",
    "test": "vitest run",
    "seed": "npm run seed -w @smartcampus/api",
    "deploy:aws": "node scripts/aws/deploy.mjs",
    "migrate:aws": "node scripts/aws/migrate.mjs",
    "destroy:aws": "node scripts/aws/destroy.mjs",
    "build:lambda": "npm run build:lambda -w @smartcampus/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
