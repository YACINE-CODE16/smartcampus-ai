ACME_EMAIL=vous@exemple.fr          # contact Let's Encrypt

# --- API ---
DATABASE_URL=postgresql://smartcampus:MOT_DE_PASSE@smartcampus-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/smartcampus?sslmode=no-verify
JWT_SECRET=GENERER_AVEC_openssl_rand_-hex_32
DEMO_MODE=true
DEMO_PASSWORD=Campus2026!

AWS_REGION=us-east-1
